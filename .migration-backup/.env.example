# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Admin Credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_password_here

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# WhatsApp Business API (Optional)
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_BUSINESS_ACCESS_TOKEN=your-access-token

# Payment Gateways (Optional)
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-password
EASYPAY_STORE_ID=your-store-id
EASYPAY_AUTHORIZATION_KEY=your-auth-key

# Sanity CMS (Optional)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXX

# Security
SECURITY_HEADERS_ENABLED=true
CSRF_TOKEN_ENABLED=true
RATE_LIMIT_ENABLED=true
